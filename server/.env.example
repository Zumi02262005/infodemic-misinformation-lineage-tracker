# Copy this file to server/.env and adjust it for your machine.

# --- PostgreSQL ---------------------------------------------------------------
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# The database is created automatically if it does not exist (the user needs the
# CREATEDB privilege, which the default "postgres" superuser has).
# If your password contains special characters such as @ : / # %, percent-encode
# them (for example "p@ss" becomes "p%40ss").
DATABASE_URL=postgres://postgres:postgres@localhost:5432/infodemic

# Load the demo narratives the first time the server starts with an empty database.
AUTO_SEED=true

# --- API server ---------------------------------------------------------------
PORT=4000
HOST=127.0.0.1

# --- NLP similarity -----------------------------------------------------------
# local       built-in engine (TF-IDF + character n-grams + misinformation lexicon), no key needed
# openai      blend in OpenAI embeddings (or any OpenAI-compatible /embeddings API)
# huggingface blend in Hugging Face Inference API sentence embeddings
NLP_PROVIDER=local

# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# HF_API_TOKEN=hf_...
# HF_MODEL=sentence-transformers/all-MiniLM-L6-v2
# HF_API_URL=   (optional full endpoint override)

# How much the embedding score counts when a provider is on (0-1), and the cosine
# value treated as "unrelated" for that model.
# SEMANTIC_WEIGHT=0.6
# SEMANTIC_FLOOR=0.2

# A new claim joins an existing narrative when its best match scores at least
# LINK_THRESHOLD. Pairs above RELATED_THRESHOLD are drawn as similarity links.
LINK_THRESHOLD=0.22
RELATED_THRESHOLD=0.2
RELATED_PER_CLAIM=2
